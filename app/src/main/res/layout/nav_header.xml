<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ic_drawer_header"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingTop="56dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivDrawerAvatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_profile"
        android:scaleType="center"
        android:background="#33FFFFFF"
        android:padding="14dp"
        android:tint="@color/white"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Avatar"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <TextView
        android:id="@+id/tvDrawerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvDrawerSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/drawer_subtitle"
        android:textColor="#CCFFFFFF"
        android:textSize="13sp" />

</LinearLayout>
