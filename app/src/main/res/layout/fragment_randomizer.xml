<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <TextView android:text="@string/what_to_study" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary"/>
    <TextView android:id="@+id/tvResult" android:text="?" android:textSize="48sp" android:textColor="@color/primary" android:layout_margin="32dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnSpin" android:text="@string/spin" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>